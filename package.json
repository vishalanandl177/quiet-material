{
  "name": "@quiet-material/core",
  "version": "1.0.0",
  "description": "A quiet, black-first, Material-inspired design system for the web.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/quiet-material.d.ts",
      "default": "./src/quiet-material.js"
    },
    "./styles.css": "./styles/quiet-material.css",
    "./tokens.css": "./styles/tokens.css",
    "./tokens.json": "./tokens/quiet-material.tokens.json"
  },
  "files": [
    "styles",
    "src",
    "tokens",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-tokens.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "package:preview": "node scripts/package-preview.mjs"
  },
  "devDependencies": {
    "jsdom": "30.1.0"
  }
}
