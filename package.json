{
  "name": "@quiet-material/core",
  "version": "1.3.0",
  "description": "A mobile-first, black Material-inspired design system with portable tokens and native starters.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/quiet-material.d.ts",
      "default": "./src/quiet-material.js"
    },
    "./styles.css": "./styles/quiet-material.css",
    "./tokens.css": "./styles/tokens.css",
    "./tokens.json": "./tokens/quiet-material.tokens.json",
    "./tokens.resolved.json": "./exports/quiet-material.tokens.resolved.json",
    "./tokens.ts": "./exports/quiet-material.tokens.ts",
    "./motion": {
      "types": "./src/motion.d.ts",
      "default": "./src/motion.js"
    },
    "./motion.json": "./exports/quiet-material.motion.json",
    "./components.json": "./exports/quiet-material.components.json"
  },
  "files": [
    "styles",
    "src",
    "tokens",
    "README.md",
    "exports",
    "platforms"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-tokens.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "package:preview": "node scripts/package-preview.mjs"
  },
  "devDependencies": {
    "jsdom": "30.1.0"
  }
}
