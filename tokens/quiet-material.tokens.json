  "motion": {
    "$description": "Semantic bindings for Quiet Material. Platform component defaults remain authoritative. Ripple timings are Material Web component timings, separate from the 16 system duration slots.",
    "state": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.short3}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.standard}"
      }
    },
    "control": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.medium2}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.standard}"
      }
    },
    "enter": {
      "duration": {
        "$type": "duration",
        "$value": "{duration.long2}"
      },
