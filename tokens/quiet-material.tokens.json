  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "standardAccelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "standardDecelerate": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$description": "Exact two-segment MD3 emphasized path. first and second are normalized cubic Bezier segments; joinX and joinY map the segments into the whole curve. This is not the standard single cubic curve.",
      "$extensions": {
        "com.quietmaterial.motion": {
          "path": "M 0,0 C 0.05,0 0.133333,0.06 0.166666,0.4 C 0.208333,0.82 0.25,1 1,1"
        }
      },
      "first": {
        "$type": "cubicBezier",
        "$value": [
          0.3000012000048,
          0,
          0.8000012000048,
          0.15
        ]
      },
      "second": {
        "$type": "cubicBezier",
        "$value": [
          0.050000359999711974,
          0.7,
          0.10000071999942399,
          1
        ]
      },
      "joinX": {
        "$type": "number",
        "$value": 0.166666
      },
      "joinY": {
        "$type": "number",
        "$value": 0.4
      }
    },
    "emphasizedAccelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        0.8,
        0.15
      ]
    },
    "emphasizedDecelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.05,
        0.7,
        0.1,
        1
      ]
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ]
    },
    "legacy": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "legacyAccelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "legacyDecelerate": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": "{easing.standardDecelerate}"
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": "{easing.standardAccelerate}"
    }
